{"108:1:1":"Certes, Nous","108:1:2":"t’avons donné","108:1:3":"le bien abondant (dont la rivière Al-Kawthar au Paradis),","108:2:1":"prie donc","108:2:2":"pour ton Maître","108:2:3":"et sacrifie.","108:3:1":"Certes,","108:3:2":"(celui) qui te déteste","108:3:3":"(est) lui","108:3:4":"celui qui est isolé."}
