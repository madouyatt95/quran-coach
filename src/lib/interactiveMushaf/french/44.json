{"44:1:1":"Ḥâʼ Mîm","44:2:1":"Par Le Livre","44:2:2":"clair !","44:3:1":"Certes, Nous","44:3:2":"l’avons fait descendre","44:3:3":"dans","44:3:4":"une nuit","44:3:5":"bénie.","44:3:6":"Certes, Nous","44:3:7":"sommes","44:3:8":"des avertisseurs.","44:4:1":"En elle","44:4:2":"est rendue distincte","44:4:3":"chaque","44:4:4":"affaire","44:4:5":"sage.","44:5:1":"Un ordre","44:5:2":"d’","44:5:3":"auprès (de) Nous.","44:5:4":"Certes, Nous","44:5:5":"sommes","44:5:6":"envoyeurs.","44:6:1":"(En tant que) miséricorde","44:6:2":"de","44:6:3":"ton Maître.","44:6:4":"Certes, Il","44:6:5":"(est) Lui","44:6:6":"Celui qui entend tout,","44:6:7":"Celui qui sait tout.","44:7:1":"(Le) Maître","44:7:2":"(des) cieux","44:7:3":"et la terre","44:7:4":"et ce qui (est)","44:7:5":"entre eux deux,","44:7:6":"si","44:7:7":"vous étiez","44:7:8":"certains.","44:8:1":"(Il n’y a) aucun","44:8:2":"dieu","44:8:3":"sauf","44:8:4":"Lui,","44:8:5":"Il donne la vie","44:8:6":"et donne la mort.","44:8:7":"Votre Maître","44:8:8":"et (Le) Maître","44:8:9":"(de) vos ancêtres","44:8:10":"premiers.","44:9:1":"Plutôt,","44:9:2":"ils","44:9:3":"dans","44:9:4":"du doute","44:9:5":"jouent.","44:10:1":"Observe donc en attendant","44:10:2":"(Le) Jour","44:10:3":"(où) amènera","44:10:4":"le ciel","44:10:5":"[] une fumée","44:10:6":"claire","44:11:1":"(qui) couvrira","44:11:2":"les gens.","44:11:3":"Ceci (est)","44:11:4":"un châtiment","44:11:5":"douloureux.","44:12:1":"« Notre Maître !","44:12:2":"Enlève","44:12:3":"de nous","44:12:4":"le châtiment !","44:12:5":"Certes, Nous","44:12:6":"(sommes) croyants ! »","44:13:1":"Comment (y aurait-il)","44:13:2":"pour eux","44:13:3":"le rappel","44:13:4":"alors que certainement","44:13:5":"est arrivé (chez) eux","44:13:6":"un Messager","44:13:7":"clair","44:14:1":"puis","44:14:2":"ils se sont détournés","44:14:3":"de lui","44:14:4":"et ont dit :","44:14:5":"« Quelqu’un d’enseigné","44:14:6":"fou. »","44:15:1":"Certes, Nous","44:15:2":"(serons) enleveurs","44:15:3":"(du) châtiment","44:15:4":"(pendant) peu.","44:15:5":"Certes, vous (serez)","44:15:6":"des gens qui retournent.","44:16:1":"(Le) Jour (où)","44:16:2":"Nous saisirons violemment","44:16:3":"(avec) le saisissement violent","44:16:4":"le plus grand.","44:16:5":"Certes, Nous","44:16:6":"(serons) vengeurs.","44:17:1":"Et très certainement","44:17:2":"Nous avons mis en grande épreuve","44:17:3":"avant eux","44:17:4":"(les) gens","44:17:5":"(de) Pharaon","44:17:6":"et est arrivé (chez) eux","44:17:7":"un Messager","44:17:8":"honorable","44:18:1":"(disant) que :","44:18:2":"« Délivrez","44:18:3":"à moi","44:18:4":"(les) esclaves","44:18:5":"(d’)Allâh !","44:18:6":"Certes, je","44:18:7":"(suis) pour vous","44:18:8":"un Messager","44:18:9":"à qui la confiance est faite. »","44:19:1":"Et que :","44:19:2":"« Ne","44:19:3":"soyez (pas) hautains","44:19:4":"au sujet d’","44:19:5":"Allâh !","44:19:6":"Certes, je","44:19:7":"vous ai amené","44:19:8":"[] une preuve autoritaire","44:19:9":"claire.","44:20:1":"Et certes, j’","44:20:2":"ai cherché refuge","44:20:3":"auprès de mon Maître","44:20:4":"et votre Maître","44:20:5":"(de ce) que","44:20:6":"vous me lapidez/insultez.","44:21:1":"Et si","44:21:2":"ne pas","44:21:3":"vous croyez","44:21:4":"à moi,","44:21:5":"alors séparez-vous (de) moi. »","44:22:1":"Et ensuite il a invoqué","44:22:2":"son Maître","44:22:3":"(en disant) que :","44:22:4":"« Ceux-là (sont)","44:22:5":"des gens","44:22:6":"criminels. »","44:23:1":"« Alors voyage [de nuit]","44:23:2":"avec Mes esclaves","44:23:3":"(de) nuit.","44:23:4":"Certes, vous (serez)","44:23:5":"suivis !","44:24:1":"Et laisse","44:24:2":"la mer","44:24:3":"calme.","44:24:4":"Certes, ils (seront)","44:24:5":"des soldats","44:24:6":"noyés. »","44:25:1":"Combien","44:25:2":"ont-ils laissés","44:25:3":"de","44:25:4":"jardins à hautes herbes","44:25:5":"et (de) sources","44:26:1":"et (de) céréales","44:26:2":"et (d’)endroit","44:26:3":"honorable","44:27:1":"et (de) biens","44:27:2":"(en qui) ils étaient","44:27:3":"en eux","44:27:4":"joyeux !","44:28:1":"Ainsi.","44:28:2":"Et Nous les avons fait hériter","44:28:3":"(à) des gens","44:28:4":"autres.","44:29:1":"Et ensuite n’","44:29:2":"ont (pas) pleuré","44:29:3":"pour eux","44:29:4":"le ciel","44:29:5":"et la terre","44:29:6":"et ne pas","44:29:7":"ils étaient","44:29:8":"des gens qui reçoivent un délai.","44:30:1":"Et très certainement","44:30:2":"Nous avons sauvé","44:30:3":"(les) enfants","44:30:4":"(d’)Israël","44:30:5":"du","44:30:6":"[le] châtiment","44:30:7":"humiliant","44:31:1":"de","44:31:2":"Pharaon.","44:31:3":"Certes, il","44:31:4":"était","44:31:5":"quelqu’un d’arrogant","44:31:6":"parmi","44:31:7":"les excessifs.","44:32:1":"Et très certainement","44:32:2":"Nous les avons choisis","44:32:3":"avec","44:32:4":"du savoir,","44:32:5":"(leur donnant préférence) au-dessus de","44:32:6":"toutes les générations de chaque créature.","44:33:1":"Et Nous leur avons donné","44:33:2":"parmi","44:33:3":"les signes","44:33:4":"ce (en) quoi","44:33:5":"(il y a) en lui","44:33:6":"une épreuve sévère et visible","44:33:7":"claire.","44:34:1":"Certes,","44:34:2":"ceux-là","44:34:3":"disent certainement :","44:35:1":"« Ne pas","44:35:2":"elle (est)","44:35:3":"sauf","44:35:4":"notre mort","44:35:5":"première","44:35:6":"et ne pas","44:35:7":"nous (serons)","44:35:8":"ressuscités.","44:36:1":"Amenez donc","44:36:2":"[] nos ancêtres","44:36:3":"si","44:36:4":"vous êtes","44:36:5":"véridiques ! »","44:37:1":"Est-ce qu’ils","44:37:2":"(sont) meilleurs","44:37:3":"ou bien","44:37:4":"(les) gens","44:37:5":"(de) Toubbaʿ","44:37:6":"et ceux qui","44:37:7":"(étaient) [d’]","44:37:8":"avant eux","44:37:9":"(qui) Nous les avons détruits ?","44:37:10":"Certes, ils","44:37:11":"étaient","44:37:12":"des criminels.","44:38:1":"Et ne pas","44:38:2":"Nous avons créé","44:38:3":"les cieux","44:38:4":"et la terre","44:38:5":"et ce qui (est)","44:38:6":"entre eux deux","44:38:7":"(en étant) joueurs.","44:39:1":"Ne pas","44:39:2":"Nous les avons créés","44:39:3":"sauf","44:39:4":"en toute la vérité","44:39:5":"mais","44:39:6":"(la) plupart (d’)eux","44:39:7":"ne","44:39:8":"savent (pas).","44:40:1":"Certes,","44:40:2":"(Le) Jour","44:40:3":"(du) Jugement","44:40:4":"(est) leur temps fixé","44:40:5":"tous ensembles.","44:41:1":"(Le) Jour (où)","44:41:2":"ne","44:41:3":"servira (pas)","44:41:4":"un allié","44:41:5":"à","44:41:6":"un allié","44:41:7":"(en) quoi que ce soit","44:41:8":"et ne pas","44:41:9":"ils","44:41:10":"recevront (d’)aide contre leurs ennemis","44:42:1":"sauf","44:42:2":"quiconque","44:42:3":"(lui) fait miséricorde","44:42:4":"Allâh.","44:42:5":"Certes, il","44:42:6":"(est) Lui","44:42:7":"Le Parfaitement Fort.","44:42:8":"Le Très Miséricordieux.","44:43:1":"Certes,","44:43:2":"(l’)arbre","44:43:3":"(du) Zaqqoûm","44:44:1":"(est la) nourriture","44:44:2":"(du) grand pécheur.","44:45:1":"Comme l’huile chauffée au fond de la casserole","44:45:2":"(qui) bouillie","44:45:3":"dans","44:45:4":"les ventres,","44:46:1":"comme (l’)ébullition","44:46:2":"(de) l’eau bouillante.","44:47:1":"« Prenez-le","44:47:2":"et traînez-le ensuite","44:47:3":"vers","44:47:4":"(le) milieu","44:47:5":"(du) Feu Ardent !","44:48:1":"Puis","44:48:2":"versez","44:48:3":"au-dessus","44:48:4":"(de) sa tête","44:48:5":"du","44:48:6":"châtiment","44:48:7":"(de) l’eau bouillante.","44:49:1":"Goûte !","44:49:2":"Certes, tu","44:49:3":"(es) toi","44:49:4":"la personne très forte","44:49:5":"honorable.","44:50:1":"Certes,","44:50:2":"ceci (est)","44:50:3":"ce dont","44:50:4":"vous vous mettiez en doute","44:50:5":"au sujet de lui","44:50:6":"vous vous mettiez en doute. »","44:51:1":"Certes,","44:51:2":"les pieux","44:51:3":"(seront) dans","44:51:4":"une position","44:51:5":"sûre,","44:52:1":"dans","44:52:2":"des jardins à hautes herbes","44:52:3":"et des sources.","44:53:1":"Ils porteront des habits","44:53:2":"de","44:53:3":"soie fine","44:53:4":"et (de) soie épaisse,","44:53:5":"(en étant) des gens qui se font face.","44:54:1":"Ainsi.","44:54:2":"Et Nous les aurions mariés","44:54:3":"à des femmes aux yeux blancs","44:54:4":"aux yeux grands.","44:55:1":"Ils réclameront","44:55:2":"en eux","44:55:3":"[pour] chaque","44:55:4":"fruit","44:55:5":"(en étant) en sécurité.","44:56:1":"Ne pas","44:56:2":"ils goûteront","44:56:3":"en eux","44:56:4":"la mort","44:56:5":"sauf","44:56:6":"la mort","44:56:7":"première.","44:56:8":"Et Il les protégera","44:56:9":"(du) châtiment","44:56:10":"(du) Feu Ardent,","44:57:1":"(par) faveur","44:57:2":"de","44:57:3":"ton Maître.","44:57:4":"Celle-là","44:57:5":"(est) elle","44:57:6":"la réussite","44:57:7":"immense.","44:58:1":"Et seulement","44:58:2":"Nous l’avons rendu facile","44:58:3":"en ta langue","44:58:4":"afin que peut-être ils","44:58:5":"se rappellent.","44:59:1":"Observe donc en attendant.","44:59:2":"Certes, ils (sont)","44:59:3":"des observateurs en attente."}
