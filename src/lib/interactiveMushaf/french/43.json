{"43:1:1":"Ḥâʼ Mîm","43:2:1":"Par Le Livre","43:2:2":"Clair !","43:3:1":"Certes, Nous","43:3:2":"avons fait (de) Lui","43:3:3":"un Coran","43:3:4":"arabe","43:3:5":"afin que peut-être vous","43:3:6":"raisonniez.","43:4:1":"Et certes, Il (est)","43:4:2":"dans","43:4:3":"(la) partie principale","43:4:4":"(du) Livre","43:4:5":"auprès (de) Nous","43:4:6":"certainement très haut,","43:4:7":"très sage.","43:5:1":"Est-ce que Nous devrions donc laisser","43:5:2":"de vous","43:5:3":"Le Rappel","43:5:4":"(avec) détournement","43:5:5":"(parce) que","43:5:6":"vous êtes","43:5:7":"des gens","43:5:8":"excessifs ?","43:6:1":"Et combien","43:6:2":"avons-Nous envoyé","43:6:3":"de","43:6:4":"Prophète(s)","43:6:5":"parmi","43:6:6":"les (gens) premiers !","43:7:1":"Et ne","43:7:2":"leur est (pas) venu","43:7:3":"de","43:7:4":"Prophète","43:7:5":"sans qu’","43:7:6":"ils se moquaient","43:7:7":"de lui","43:7:8":"ils se moquaient.","43:8:1":"Et Nous avons détruit","43:8:2":"(des gens) plus forts","43:8:3":"qu’eux","43:8:4":"(en) saisie violente (=en force)","43:8:5":"et est passé","43:8:6":"(l’)exemple","43:8:7":"(des gens) premiers.","43:9:1":"Et certainement si","43:9:2":"tu leur demandais","43:9:3":"qui","43:9:4":"a créé","43:9:5":"les cieux","43:9:6":"et la terre,","43:9:7":"ils diraient très certainement :","43:9:8":"« Les a créés","43:9:9":"Le Parfaitement Fort.","43:9:10":"Celui qui sait tout. »","43:10:1":"Celui qui","43:10:2":"a fait","43:10:3":"pour vous","43:10:4":"la terre","43:10:5":"(en tant que) berceau","43:10:6":"et a placé","43:10:7":"pour vous","43:10:8":"en elle","43:10:9":"des voies","43:10:10":"afin que peut-être vous","43:10:11":"soyez guidés.","43:11:1":"Et Celui qui","43:11:2":"a fait descendre en étapes","43:11:3":"du","43:11:4":"[le] ciel","43:11:5":"de l’eau","43:11:6":"avec mesure","43:11:7":"et Nous ressuscitons ensuite","43:11:8":"par elle","43:11:9":"une région","43:11:10":"morte.","43:11:11":"Ainsi","43:11:12":"vous serez sortis.","43:12:1":"Et Celui qui","43:12:2":"a créé","43:12:3":"les types","43:12:4":"chacun (d’)eux","43:12:5":"et a fait","43:12:6":"pour vous","43:12:7":"des","43:12:8":"[les] bateaux","43:12:9":"et (du) bétail","43:12:10":"ce que","43:12:11":"vous montez","43:13:1":"afin que vous vous asseyez fermement","43:13:2":"sur","43:13:3":"ses dos/ses surfaces","43:13:4":"puis","43:13:5":"vous rappellerez","43:13:6":"(du) bienfait","43:13:7":"(de) votre Maître","43:13:8":"quand","43:13:9":"vous vous êtes assis fermement","43:13:10":"sur lui","43:13:11":"et direz :","43:13:12":"« (Est déclarée La) Perfection","43:13:13":"(de) Celui qui","43:13:14":"a rendu soumis","43:13:15":"pour nous","43:13:16":"ceci.","43:13:17":"Et ne pas","43:13:18":"nous étions","43:13:19":"de lui","43:13:20":"capables.","43:14:1":"Et certes, nous","43:14:2":"(serons) vers","43:14:3":"notre Maître","43:14:4":"certainement retourneurs. »","43:15:1":"Et ils ont fait","43:15:2":"pour Lui","43:15:3":"de","43:15:4":"Ses esclaves","43:15:5":"une partie.","43:15:6":"Certes,","43:15:7":"l’humain (est)","43:15:8":"certainement quelqu’un de très ingrat","43:15:9":"clair.","43:16:1":"Ou est-ce qu’","43:16:2":"il a pris","43:16:3":"de ce qu’","43:16:4":"Il crée","43:16:5":"des filles","43:16:6":"et a élu (pour) vous","43:16:7":"[] les fils ?","43:17:1":"Et quand","43:17:2":"reçoit bonne nouvelle","43:17:3":"(l’)un (d’)eux","43:17:4":"de ce (pour) quoi","43:17:5":"il met en avant","43:17:6":"pour L’Extrêmement Miséricordieux en Son Essence","43:17:7":"(quelque chose de) semblable,","43:17:8":"devient","43:17:9":"son visage","43:17:10":"noir","43:17:11":"dans l’état où il (est)","43:17:12":"fortement restreint (par la tristesse).","43:18:1":"Et est-ce que ce qui","43:18:2":"est mis à grandir","43:18:3":"parmi","43:18:4":"les bijoux","43:18:5":"et (est) lui","43:18:6":"dans","43:18:7":"la dispute","43:18:8":"non-","43:18:9":"clair (est attribué à Allâh) ?","43:19:1":"Et ils ont fait","43:19:2":"(des) anges","43:19:3":"qui (sont)","43:19:4":"eux","43:19:5":"(les) esclaves","43:19:6":"(de) L’Extrêmement Miséricordieux en Son Essence","43:19:7":"des femelles.","43:19:8":"Est-ce qu’ils ont témoigné","43:19:9":"(de) leur création ?","43:19:10":"Sera très bientôt écrit","43:19:11":"leur témoignage","43:19:12":"et ils seront interrogés.","43:20:1":"Et ils ont dit :","43:20:2":"« Si","43:20:3":"avait voulu","43:20:4":"L’Extrêmement Miséricordieux en Son Essence,","43:20:5":"ne pas","43:20:6":"nous les aurions adorés. »","43:20:7":"(il n’y a) pas","43:20:8":"à eux","43:20:9":"au sujet de cela","43:20:10":"de","43:20:11":"savoir.","43:20:12":"Ne pas","43:20:13":"ils (font)","43:20:14":"sauf","43:20:15":"deviner.","43:21:1":"Ou est-ce que","43:21:2":"Nous leur avons donné","43:21:3":"un écrit","43:21:4":"[d’]","43:21:5":"avant Lui","43:21:6":"et donc ils (sont)","43:21:7":"à Lui","43:21:8":"des gens qui tiennent fermement ?","43:22:1":"Plutôt,","43:22:2":"ils ont dit :","43:22:3":"« Certes, nous","43:22:4":"avons trouvé","43:22:5":"nos ancêtres","43:22:6":"(accoutumés) à","43:22:7":"une religion.","43:22:8":"Et certes, nous","43:22:9":"sur","43:22:10":"leurs traces","43:22:11":"(sommes) guidés. »","43:23:1":"Et ainsi","43:23:2":"ne pas","43:23:3":"Nous avons envoyé","43:23:4":"[d’]","43:23:5":"avant toi","43:23:6":"dans","43:23:7":"un village","43:23:8":"d’","43:23:9":"avertisseur","43:23:10":"sans qu’","43:23:11":"aient dit","43:23:12":"ses gens aisés :","43:23:13":"« Certes, nous","43:23:14":"avons trouvé","43:23:15":"nos ancêtres","43:23:16":"(accoutumés) à","43:23:17":"une religion.","43:23:18":"Et certes, nous","43:23:19":"(sommes) sur","43:23:20":"leurs traces","43:23:21":"des gens qui suivent. »","43:24:1":"Il a dit :","43:24:2":"« Est-ce que même si","43:24:3":"je vous ai apportés","43:24:4":"[] quelque chose qui guide mieux","43:24:5":"que ce (à) que","43:24:6":"vous avez trouvé","43:24:7":"(accoutumés) à lui","43:24:8":"vos pères ? »","43:24:9":"Ils ont dit :","43:24:10":"« Certes, nous","43:24:11":"(sommes) en ce (avec) quoi","43:24:12":"vous avez été envoyé","43:24:13":"avec lui","43:24:14":"des mécréants ! »","43:25:1":"Et Nous Nous sommes ensuite vengés","43:25:2":"contre eux.","43:25:3":"Regarde donc","43:25:4":"comment","43:25:5":"était","43:25:6":"(la) fin","43:25:7":"(de) ceux qui démentent.","43:26:1":"Et quand","43:26:2":"a dit","43:26:3":"Abraham","43:26:4":"à son père","43:26:5":"et (à) son peuple :","43:26:6":"« Certes, je","43:26:7":"(suis) désavoué","43:26:8":"de ce que","43:26:9":"vous adorez","43:27:1":"sauf","43:27:2":"Celui qui","43:27:3":"m’a créé et rendu manifeste,","43:27:4":"alors certes, Il","43:27:5":"me guidera très bientôt. »","43:28:1":"Et il l’a rendue","43:28:2":"une parole","43:28:3":"restante","43:28:4":"parmi","43:28:5":"ses descendants","43:28:6":"afin que peut-être ils","43:28:7":"retournent.","43:29:1":"Plutôt,","43:29:2":"J’ai donné des biens","43:29:3":"(à) ceux-là","43:29:4":"et (à) leurs ancêtres","43:29:5":"jusqu’à-ce que","43:29:6":"sont arrivés (chez) eux","43:29:7":"la vérité","43:29:8":"et un Messager","43:29:9":"clair.","43:30:1":"Et quand","43:30:2":"est arrivé (chez) eux","43:30:3":"la vérité,","43:30:4":"ils ont dit :","43:30:5":"« Ceci (est)","43:30:6":"de la magie.","43:30:7":"Et certes, nous","43:30:8":"(sommes) en lui","43:30:9":"des mécréants. »","43:31:1":"Et ils ont dit :","43:31:2":"« Pourquoi n’","43:31:3":"a (pas) été descendu [en étapes]","43:31:4":"Ce","43:31:5":"[Le] Coran","43:31:6":"à","43:31:7":"un homme","43:31:8":"des","43:31:9":"[les] deux villages","43:31:10":"immense (en position) ? »","43:32:1":"Est-ce qu’ils","43:32:2":"distribuent","43:32:3":"(La) Miséricorde","43:32:4":"(de) ton Maître ?","43:32:5":"Nous","43:32:6":"avons distribué","43:32:7":"entre eux","43:32:8":"leurs moyens de vivre","43:32:9":"dans","43:32:10":"la vie","43:32:11":"(de) l’ici-bas.","43:32:12":"Et Nous avons élevé","43:32:13":"certains (d’)eux","43:32:14":"au-dessus","43:32:15":"(de) certains","43:32:16":"(en) niveaux","43:32:17":"afin que prennent","43:32:18":"certains (d’)eux","43:32:19":"certains","43:32:20":"(en tant qu’)esclaves soumis.","43:32:21":"Et (La) Miséricorde","43:32:22":"(de) ton Maître","43:32:23":"(est) meilleure","43:32:24":"que ce qu’","43:32:25":"ils assemblent.","43:33:1":"Et si (ce n’était) pas (pour)","43:33:2":"(le fait) que","43:33:3":"seraient","43:33:4":"les gens","43:33:5":"une communauté","43:33:6":"seule,","43:33:7":"Nous aurions certainement fait","43:33:8":"pour quiconque","43:33:9":"mécroit","43:33:10":"en L’Extrêmement Miséricordieux en Son Essence","43:33:11":"pour leurs maisons","43:33:12":"des toits","43:33:13":"d’","43:33:14":"argent","43:33:15":"et des escaliers","43:33:16":"(qui) sur eux","43:33:17":"ils montent","43:34:1":"et pour leurs maisons","43:34:2":"des portes","43:34:3":"et des lits","43:34:4":"(qui) sur eux","43:34:5":"ils s’allongent","43:35:1":"et de l’or.","43:35:2":"Et n’(est) pas","43:35:3":"tout","43:35:4":"cela","43:35:5":"sauf","43:35:6":"(le) bien (temporaire)","43:35:7":"(de) la vie","43:35:8":"(de) l’ici-bas.","43:35:9":"Et l’au-delà","43:35:10":"(est) auprès","43:35:11":"(de) ton Maître","43:35:12":"pour les pieux.","43:36:1":"Et quiconque","43:36:2":"se détourne de la lumière","43:36:3":"du","43:36:4":"rappel","43:36:5":"(de) L’Extrêmement Miséricordieux en Son Essence,","43:36:6":"Nous désignons","43:36:7":"pour Lui","43:36:8":"un démon","43:36:9":"et il (est) donc","43:36:10":"à lui","43:36:11":"un camarade.","43:37:1":"Et certes, ils","43:37:2":"les détournent certainement","43:37:3":"de","43:37:4":"la voie","43:37:5":"alors qu’ils pensent","43:37:6":"qu’ils","43:37:7":"(sont) guidés.","43:38:1":"Jusqu’à-ce que,","43:38:2":"quand","43:38:3":"il arrive (chez) Nous,","43:38:4":"il dit :","43:38:5":"« Ô (le) souhait","43:38:6":"(qu’il y ait) entre moi","43:38:7":"et [entre] toi","43:38:8":"(la) distance","43:38:9":"(de) l’est et l’ouest !","43:38:10":"Comme est donc mauvais","43:38:11":"le compagnon ! »","43:39:1":"Et jamais ne","43:39:2":"vous profitera","43:39:3":"Ce Jour,","43:39:4":"quand","43:39:5":"vous avez fait injustice,","43:39:6":"que vous","43:39:7":"(êtes) dans","43:39:8":"le châtiment","43:39:9":"des associés.","43:40:1":"Donc est-ce que tu","43:40:2":"pourrais faire entendre","43:40:3":"les sourds","43:40:4":"ou","43:40:5":"pourrais guider","43:40:6":"les aveugles","43:40:7":"et quiconque","43:40:8":"est","43:40:9":"en","43:40:10":"égarement","43:40:11":"clair ?","43:41:1":"Et ensuite, que","43:41:2":"Nous enlevons certainement","43:41:3":"[] toi","43:41:4":"et ensuite certes Nous","43:41:5":"(serons) contre eux","43:41:6":"vengeurs","43:42:1":"ou","43:42:2":"Nous te montrions certainement","43:42:3":"ce que","43:42:4":"Nous leur avons promis,","43:42:5":"alors certes, Nous","43:42:6":"(sommes) contre eux","43:42:7":"parfaitement capables !","43:43:1":"Tiens donc fermement","43:43:2":"à Ce qui","43:43:3":"a été révélé","43:43:4":"vers toi.","43:43:5":"Certes, tu","43:43:6":"(es) sur","43:43:7":"un chemin","43:43:8":"droit.","43:44:1":"Et certes, Il (est)","43:44:2":"certainement un rappel","43:44:3":"pour toi","43:44:4":"et pour ton peuple.","43:44:5":"Et bientôt","43:44:6":"vous serez interrogés.","43:45:1":"Et demande","43:45:2":"quiconque","43:45:3":"Nous avons envoyé","43:45:4":"[d’]","43:45:5":"avant toi","43:45:6":"parmi","43:45:7":"Nos Messagers :","43:45:8":"Est-ce que Nous avons fait","43:45:9":"d’","43:45:10":"en-dehors","43:45:11":"(de) L’Extrêmement Miséricordieux en Son Essence","43:45:12":"des dieux","43:45:13":"(qui) sont adorés ?","43:46:1":"Et très certainement","43:46:2":"Nous avons envoyé","43:46:3":"Moïse","43:46:4":"avec Nos signes","43:46:5":"vers","43:46:6":"Pharaon","43:46:7":"et ses notables","43:46:8":"et il a ensuite dit :","43:46:9":"« Certes, je","43:46:10":"(suis) un Messager","43:46:11":"(du) Maître","43:46:12":"(de) toutes les générations de chaque créature. »","43:47:1":"Et ensuite, quand","43:47:2":"il leur a apporté","43:47:3":"[] Nos s