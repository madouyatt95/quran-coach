{"92:1:1":"Par la nuit","92:1:2":"quand","92:1:3":"elle couvre","92:2:1":"et le jour","92:2:2":"quand","92:2:3":"il se manifeste avec sa beauté","92:3:1":"et Celui qui","92:3:2":"a créé","92:3:3":"le mâle","92:3:4":"et la femelle !","92:4:1":"Certes,","92:4:2":"votre effort","92:4:3":"(sont) diverses.","92:5:1":"Donc, quant à","92:5:2":"quiconque","92:5:3":"a donné","92:5:4":"et a craint avec piété","92:6:1":"et a affirmé","92:6:2":"[en] ce qui est meilleur,","92:7:1":"alors Nous le disposerons très bientôt","92:7:2":"vers le facile.","92:8:1":"Et quant à","92:8:2":"quiconque","92:8:3":"a retenu par avarice","92:8:4":"et s’est considéré libre de besoins","92:9:1":"et a dénié","92:9:2":"[en] ce qui est meilleur,","92:10:1":"alors Nous le disposerons très bientôt","92:10:2":"vers le difficile.","92:11:1":"Et (à) quoi","92:11:2":"serviront","92:11:3":"à lui","92:11:4":"ses richesses","92:11:5":"quand","92:11:6":"il sera jeté en étant ruiné ?","92:12:1":"Certes,","92:12:2":"(est obligatoire) à Nous","92:12:3":"certainement la guidance.","92:13:1":"Et certes,","92:13:2":"à Nous (appartiennent)","92:13:3":"certainement l’au-delà","92:13:4":"et la première (vie).","92:14:1":"Je vous avertis donc","92:14:2":"(d’)un Feu","92:14:3":"(qui) flambe,","92:15:1":"(en qui) ne","92:15:2":"sera (pas) brûlé (en) lui","92:15:3":"sauf","92:15:4":"le plus misérable,","92:16:1":"celui qui","92:16:2":"a démenti","92:16:3":"et s’est détourné,","92:17:1":"et sera très bientôt mis à l’éviter","92:17:2":"le plus pieux,","92:18:1":"celui qui","92:18:2":"donne","92:18:3":"sa richesse","92:18:4":"(afin qu’)il se purifie,","92:19:1":"alors que ne pas","92:19:2":"(il y a) à quiconque","92:19:3":"auprès (de) lui","92:19:4":"de","92:19:5":"bienfait","92:19:6":"(qui) est récompensé [sans diminution],","92:20:1":"(il ne le fait pas) sauf","92:20:2":"(à la) recherche","92:20:3":"(du) Visage","92:20:4":"(de) son Maître,","92:20:5":"Le Plus Haut.","92:21:1":"Et certainement bientôt","92:21:2":"il sera satisfait."}
